<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <NoWarn>CA1416;WFO1000</NoWarn>
    <!-- A demo, like GridKrafter.Demo.Mvc: exempt from the solution's XML documentation rule. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))'=='net'">
    <OutputPath>bin\</OutputPath>
    <StartupObject></StartupObject>
    <OutputType>Library</OutputType>
    <RunCommand>$(ProgramFiles)\IIS Express\iisexpress.exe</RunCommand>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RunArguments>/path:"$(MSBuildProjectDirectory)" /port:5000</RunArguments>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))'!='net'">
    <StartupObject>$(RootNamespace).Startup</StartupObject>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))'=='net'">
    <Reference Include="System.Windows.Forms" />
    <Compile Remove="Startup.cs" />
    <Content Include="Startup.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Default.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <None Remove="Default.html" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Default.html">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="favicon.ico">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GridKrafter.Core\GridKrafter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- GridBoard: its files, each embedded under the name Wisej.NET or the Toolbox reads it by (added by Component Studio) -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\GridBoard\GridBoard.mixin.theme">
      <DependentUpon>GridBoard.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Themes.GridBoard.mixin.theme</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\GridBoard\GridBoard.bmp">
      <DependentUpon>GridBoard.cs</DependentUpon>
      <LogicalName>GridKrafter.WisejDemo.Controls.GridBoard.bmp</LogicalName>
    </EmbeddedResource>
    <None Remove="$(MSBuildThisFileDirectory)Controls\GridBoard\gridkrafter.wisejdemo.GridBoard.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\GridBoard\gridkrafter.wisejdemo.GridBoard.js">
      <DependentUpon>GridBoard.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Platform.gridkrafter.wisejdemo.GridBoard.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wisej-4" Version="4.2.0-test.7" />
    <PackageReference Include="Wisej-4-BootstrapIcons" Version="4.0.*" />
    <PackageReference Include="Wisej-4-NavigationBar" Version="4.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- ActivityList: its client class and theme mixin, embedded under the names Wisej.NET reads them by -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\ActivityList\ActivityList.mixin.theme">
      <DependentUpon>ActivityList.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Themes.ActivityList.mixin.theme</LogicalName>
    </EmbeddedResource>
    <None Remove="$(MSBuildThisFileDirectory)Controls\ActivityList\gridkrafter.wisejdemo.ActivityList.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\ActivityList\gridkrafter.wisejdemo.ActivityList.js">
      <DependentUpon>ActivityList.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Platform.gridkrafter.wisejdemo.ActivityList.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- ServerLoadList: its client class and theme mixin, embedded under the names Wisej.NET reads them by -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\ServerLoadList\ServerLoadList.mixin.theme">
      <DependentUpon>ServerLoadList.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Themes.ServerLoadList.mixin.theme</LogicalName>
    </EmbeddedResource>
    <None Remove="$(MSBuildThisFileDirectory)Controls\ServerLoadList\gridkrafter.wisejdemo.ServerLoadList.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\ServerLoadList\gridkrafter.wisejdemo.ServerLoadList.js">
      <DependentUpon>ServerLoadList.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Platform.gridkrafter.wisejdemo.ServerLoadList.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- StatTile: its client class and theme mixin, embedded under the names Wisej.NET reads them by -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\StatTile\StatTile.mixin.theme">
      <DependentUpon>StatTile.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Themes.StatTile.mixin.theme</LogicalName>
    </EmbeddedResource>
    <None Remove="$(MSBuildThisFileDirectory)Controls\StatTile\gridkrafter.wisejdemo.StatTile.js" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Controls\StatTile\gridkrafter.wisejdemo.StatTile.js">
      <DependentUpon>StatTile.cs</DependentUpon>
      <LogicalName>$(RootNamespace).Platform.gridkrafter.wisejdemo.StatTile.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
